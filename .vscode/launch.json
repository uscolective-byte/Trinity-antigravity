{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "arazzo",
      "request": "launch",
      "name": "Debug ",
      "spec": "${file
    }","workflowId": "workflow-id","inputs": {}
  },
  {
    "type": "arazzo",
    "request": "launch",
    "name": "Debug workflow-name",
    "spec": "${file}",
    "workflowId": "workflow-id",
    "inputs": {}
  },
  {
    "name": "Debugger for Mainframe: INTERTEST™ FOR BATCH",
    "type": "intertest-batch",
    "request": "launch",
    "programName": [
      "PROGNAME"
    ],
    "protsym": [
      "PROTSYM"
    ],
    "host": "HOST",
    "port": 0,
    "interTestUserName": "USER",
    "interTestSecure": true,
    "ssh": {
      "enabled": false
    },
    "convertedJCL": ""
  },
  {
    "type": "arazzo",
    "request": "launch",
    "name": "Debug workflow-name (stop on entry)",
    "spec": "${file}",
    "workflowId": "workflow-id",
    "inputs": {},
    "stopOnEntry": true
  },
  {
    "type": "firefox",
    "request": "launch",
    "reAttach": true,
    "name": "Launch index.html",
    "file": "${workspaceFolder}/index.html"
  },
  {
    "type": "dockerfile",
    "request": "launch",
    "name": "Docker: Build",
    "dockerfile": "Dockerfile",
    "contextPath": "${workspaceFolder}"
  },
  {
    "type": "cmake",
    "request": "launch",
    "name": "CMake: Script debugging",
    "cmakeDebugType": "script",
    "scriptPath": "${workspaceFolder}/<...>.cmake"
  },
  {
    "type": "arazzo",
    "request": "launch",
    "name": "Debug 
    
      (stop on entry)","spec": "${file
    }","workflowId": "workflow-id","inputs": {},"stopOnEntry": true
  },
  {
    "type": "firefox",
    "request": "launch",
    "reAttach": true,
    "name": "Launch localhost",
    "url": "http://localhost/index.html",
    "webRoot": "${workspaceFolder}"
  },
  {
    "name": "Debugger for Mainframe: INTERTEST™ FOR BATCH",
    "type": "intertest-batch",
    "request": "launch",
    "programName": [
      "PROGNAME"
    ],
    "protsym": [
      "PROTSYM"
    ],
    "host": "HOST",
    "port": 0,
    "interTestUserName": "USER",
    "interTestSecure": true,
    "ssh": {
      "enabled": false
    },
    "convertedJCL": ""
  },
  {
    "type": "cmake",
    "request": "launch",
    "name": "CMake: Configure project",
    "cmakeDebugType": "configure",
    "clean": false,
    "configureAll": false
  },
  {
    "type": "node",
    "request": "launch",
    "name": "Trinity: Launch Next.js Dashboard",
    "runtimeExecutable": "npm",
    "runtimeArgs": [
      "run",
      "dev"
    ],
    "cwd": "${workspaceFolder}",
    "internalConsoleOptions": "neverOpen"
  },
  {
    "type": "node",
    "request": "launch",
    "name": "Trinity: Cloudflare Worker Dev",
    "runtimeExecutable": "npm",
    "runtimeArgs": [
      "run",
      "dev"
    ],
    "cwd": "${workspaceFolder}/Trinity",
    "internalConsoleOptions": "openOnSessionStart"
  },
  {
    "type": "node",
    "request": "launch",
    "name": "Trinity: MCP Stdio Bridge",
    "program": "${workspaceFolder}/scripts/trinity-mcp-bridge/server.mjs",
    "env": {
      "MCP_STDIO": "true",
      "TRINITY_WORKSPACE": "${workspaceFolder}"
    },
    "internalConsoleOptions": "openOnSessionStart"
  },
  {
    "type": "node",
    "request": "launch",
    "name": "Trinity: Local Desktop Server",
    "program": "${workspaceFolder}/Local-Desktop/server.mjs",
    "cwd": "${workspaceFolder}/Local-Desktop",
    "internalConsoleOptions": "openOnSessionStart"
  }
]
}