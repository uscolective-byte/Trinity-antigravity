{
  "inputs": [
    {
      "type": "promptString",
      "id": "trinity-prod-mcp-token",
      "description": "Production Trinity MCP key (trn_live_...), read only preferred",
      "password": true
    },
    {
      "type": "promptString",
      "id": "trinity-staging-mcp-token",
      "description": "Staging Trinity MCP key (trn_live_...), separate D1 account key",
      "password": true
    }
  ],
  "servers": {
    "trinity": {
      "type": "http",
      "url": "https://auru.space/mcp",
      "headers": {
        "Authorization": "Bearer ${input:trinity-prod-mcp-token}"
      }
    },
    "trinity-development": {
      "type": "http",
      "url": "https://auru.dev/mcp",
      "headers": {
        "Authorization": "Bearer ${input:trinity-staging-mcp-token}"
      }
    },
    "cloudflare-api": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "copilot-studio": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@microsoft/copilot-studio-mcp@latest"
      ]
    }
  }
}
