# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim
WORKDIR /app
RUN chown node:node /app && apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY --chown=node:node . .
USER node
RUN --mount=type=secret,id=build_ca,mode=0444 \
    if [ -r /run/secrets/build_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/build_ca; fi; \
    npm --prefix Trinity ci --no-audit --no-fund
CMD ["node", "Local-Gateway/src/cloud-runner.mjs"]
