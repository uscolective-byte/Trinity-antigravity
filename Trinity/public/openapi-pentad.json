{
  "openapi": "3.1.0",
  "info": {
    "title": "TRINITY Sovereign Pentad MCP Gateway",
    "version": "11.0.0",
    "description": "Unified Model Context Protocol (MCP) and REST router connecting Cloudflare Sovereign Core (Trinity), Antigravity IDE, Google Gemini, Microsoft Copilot Studio (crm17), and ChatGPT/Codex.",
    "contact": {
      "name": "Sabo Ivan / Basterix",
      "email": "saboivan2008@gmail.com",
      "url": "https://auru.space"
    },
    "license": {
      "name": "Proprietary Sovereign License (TRINITY-DEED-20261025-001)"
    }
  },
  "servers": [
    {
      "url": "https://auru.space",
      "description": "TRINITY Sovereign Production Hub (Cloudflare Edge)"
    },
    {
      "url": "https://auru.dev",
      "description": "TRINITY Sovereign Production Hub · Edge Mirror (auru.dev)"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/mcp": {
      "post": {
        "operationId": "callMcpJsonRpc",
        "summary": "Standard JSON-RPC 2.0 entry point for MCP clients (Antigravity, Gemini CLI, Claude, Copilot)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonRpcRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC 2.0 response containing the MCP tool execution result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access (missing or invalid Bearer token)"
          }
        }
      }
    },
    "/api/mcp/invoke": {
      "post": {
        "operationId": "invokePentadTool",
        "summary": "REST Action Wrapper for Microsoft Copilot Studio Custom Connector and ChatGPT Custom Actions",
        "description": "Enables systems that do not support native JSON-RPC to invoke any tool from the Trinity fleet via a simple REST POST.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToolInvokeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful tool execution with audit proof receipt_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolInvokeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments or missing tool name"
          },
          "401": {
            "description": "Unauthorized access"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getEcosystemHealth",
        "summary": "Health and readiness status of the 29-service Trinity fleet",
        "security": [],
        "responses": {
          "200": {
            "description": "Ecosystem health, version, and binding readiness status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": { "type": "string", "example": "Trinity" },
                    "version": { "type": "string", "example": "11.0.0" },
                    "status": { "type": "string", "example": "serving" },
                    "truth_mode": { "type": "string", "example": "evidence-required" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT/DPAPI",
        "description": "Protected bearer token for Trinity MCP Hub"
      }
    },
    "schemas": {
      "JsonRpcRequest": {
        "type": "object",
        "required": ["jsonrpc", "id", "method"],
        "properties": {
          "jsonrpc": { "type": "string", "enum": ["2.0"] },
          "id": { "type": ["string", "number"], "example": 1 },
          "method": { "type": "string", "example": "tools/call" },
          "params": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "example": "trinity_status" },
              "arguments": { "type": "object" }
            }
          }
        }
      },
      "JsonRpcResponse": {
        "type": "object",
        "required": ["jsonrpc", "id"],
        "properties": {
          "jsonrpc": { "type": "string", "enum": ["2.0"] },
          "id": { "type": ["string", "number"], "example": 1 },
          "result": { "type": "object" },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "number" },
              "message": { "type": "string" }
            }
          }
        }
      },
      "ToolInvokeRequest": {
        "type": "object",
        "required": ["tool"],
        "properties": {
          "tool": {
            "type": "string",
            "description": "Tool name from the Pentad allowlisted catalog",
            "enum": [
              "trinity_status",
              "pc_status",
              "search_memory",
              "dispatch_task",
              "get_task",
              "trinity_memory_sync",
              "dispatch_to_agent",
              "diagnostic_ping"
            ],
            "example": "trinity_status"
          },
          "arguments": {
            "type": "object",
            "description": "Arguments passed to the invoked tool",
            "example": {}
          }
        }
      },
      "ToolInvokeResponse": {
        "type": "object",
        "required": ["status", "tool", "result"],
        "properties": {
          "status": { "type": "string", "example": "completed" },
          "tool": { "type": "string", "example": "trinity_status" },
          "receipt_id": { "type": "string", "example": "TRN-RCPT-M018-AB34" },
          "result": { "type": "object" }
        }
      }
    }
  }
}
