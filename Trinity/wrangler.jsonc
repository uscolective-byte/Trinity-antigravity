{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trinity",
  "main": "src/index.js",
  "account_id": "b60342e5e52f5646fbd4e913bb409334",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "auru.space",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "*/30 * * * *",
      "0 0 * * *",
      "0 11 * * *"
    ]
  },
